# Server Environment Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aventra_dev?schema=public"

# JWT Secrets (Will be used in Module 03)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Payment Provider Sandbox (Mock / Stripe / Razorpay)
PAYMENT_PROVIDER=mock_sandbox
